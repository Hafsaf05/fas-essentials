# Node 24 LTS. Development defaults below; production must set NODE_ENV=production.
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./data/store.sqlite
# Set to 1 only behind one trusted reverse proxy that replaces forwarded headers.
TRUST_PROXY=0
# All three enable online payments. Use test keys in staging; never VITE_ prefixes.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional transactional email + newsletter + password recovery.
RESEND_API_KEY=
MAIL_FROM=
SUPPORT_EMAIL=
# Admin order notification recipient; also used by npm run admin:create.
ADMIN_EMAIL=
# Only needed for npm run admin:create. Remove the password afterward.
ADMIN_PASSWORD=
